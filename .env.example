# ==============================================================================
# TRAC Platform Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure values for your environment.
# Never commit .env or raw cryptographic keys to version control.
# ==============================================================================

# --- Platform Deployment & Security Mode ---
# Set to 'production' to enforce strict secrets provisioning and fail-closed security gates.
TRAC_ENV=development
REQUIRE_DEPLOYMENT_SECRETS=false

# --- Authentication & Service Secrets ---
# 32+ byte hex-encoded secrets used to sign module and user JWT bearer tokens.
# In production, these must be explicitly configured via secure secrets manager.
MODULE_SECRET=
USER_SECRET=

# --- Database Configuration ---
# Default is local SQLite. In production, configure PostgreSQL.
DATABASE_URL=sqlite:///./trac_dev.db
SQL_ECHO=false

# --- M1 Ingestion & Sample Vault ---
# Directory where defanged and encrypted binary samples are stored.
VAULT_STORAGE_PATH=./data/vault
# 32-byte base64-encoded Fernet master key for sample vault encryption.
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_ENCRYPTION_KEY=

# Default password used to decompress password-protected ZIP archives (e.g. MalwareBazaar convention).
TRAC_ARCHIVE_PASSWORD=infected

# --- M3 Dynamic Sandbox Integration (CAPEv2) ---
# Endpoint URL and token for the self-hosted CAPEv2 sandbox REST API.
# Leave blank to run in isolated/static-only mode (dynamic stage will report 'skipped').
TRAC_CAPE_URL=
TRAC_CAPE_TOKEN=
# Operator attestation that the sandbox VM reverted to a clean snapshot after execution.
# TRAC strictly requires this attestation (true/false) before accepting dynamic telemetry.
TRAC_CAPE_SNAPSHOT_REVERTED=false

# --- M5 Threat Intelligence & Scoring ---
# Path to custom known-bad threat intelligence hash corpus (optional override).
TRAC_KNOWN_BAD_DB=

# --- Service Communication Endpoints ---
# Internal service endpoints for inter-module REST communication.
M7_API_URL=http://127.0.0.1:8000
M1_INTAKE_URL=http://127.0.0.1:8001
M6_MODULE_TOKEN=

# --- M8 Command Console & Reporting ---
TRAC_UI_HOST=127.0.0.1
TRAC_UI_PORT=8088
# Comma-separated list of allowed CORS origins. Keep empty or same-origin for maximum security.
TRAC_UI_ALLOWED_ORIGINS=
# Directory for generated PDF and HTML incident analysis reports.
TRAC_REPORTS_DIR=./data/reports
