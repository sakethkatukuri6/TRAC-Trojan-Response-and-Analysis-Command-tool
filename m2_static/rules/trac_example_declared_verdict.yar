/*
    This rule is the written form of TRAC's scoring contract, and it is inert
    against anything but TRAC's own test artefacts.

    A rule may move the threat score ONLY by declaring it: tag `malicious`, or
    meta.verdict = "malicious", or meta.malicious = true. m2_static.yara_scan
    .asserts_malicious() reads exactly those three, and m5_detection refuses points
    for a match that has none of them. That is what makes a signature contribution
    auditable back to a reviewable line in this directory, instead of to a rule name
    somebody guessed at.

    The pattern below is a synthetic marker generated by TRAC's own tests. It
    matches no real-world file. Copy this shape when you add a rule that carries a
    verdict, and set meta.family only if you can defend the identification -
    `m2_static/rules/README.md` states the house rules.
*/
rule TRAC_Example_Declared_Verdict_Marker : malicious
{
    meta:
        author = "TRAC"
        description = "Synthetic marker proving a declared-verdict rule scores; matches no real file"
        verdict = "malicious"
        reference = "m2_static/rules/README.md"

    strings:
        $marker = "TRAC-DEMO-SIGNATURE-DECLARED-MALICIOUS" ascii wide

    condition:
        $marker
}
